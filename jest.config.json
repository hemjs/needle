{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testRegex": ".test.ts$",
  "verbose": true,
  "moduleNameMapper": {
    "^(\\.{1,2}/.*)\\.js$": "$1"
  },
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "tsconfig": {
          "module": "commonjs",
          "moduleResolution": "bundler",
          "verbatimModuleSyntax": false,
          "isolatedModules": true
        }
      }
    ]
  },
  "coverageDirectory": "./coverage",
  "collectCoverageFrom": ["src/**/*"],
  "testEnvironment": "node",
  "coverageProvider": "v8"
}
