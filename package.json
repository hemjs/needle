{
  "name": "@hemjs/needle",
  "version": "1.3.0",
  "description": "A fast and intuitive dependency injection container for JavaScript and Node.js",
  "author": "Augustus Kamau",
  "license": "MIT",
  "keywords": [
    "hemjs",
    "needle",
    "container",
    "dependency-injection"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "tsc -p tsconfig.build.json",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "lint": "eslint \"{src,tests}/**/*.ts\" --fix",
    "lint:package": "publint && attw --pack . --profile esm-only",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:watch": "vitest",
    "prerelease": "npm run prebuild && npm run build",
    "release": "release-it",
    "prepare": "husky"
  },
  "dependencies": {
    "@armscye/container": "^0.7.0",
    "@armscye/core": "^0.4.3"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.0",
    "@vitest/coverage-v8": "5.0.4",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.9",
    "publint": "0.3.25",
    "release-it": "21.1.0",
    "rimraf": "6.1.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.4"
  },
  "homepage": "https://github.com/hemjs/needle#readme",
  "bugs": {
    "url": "https://github.com/hemjs/needle/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hemjs/needle.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "lint-staged": {
    "*.ts": [
      "prettier --write",
      "eslint --fix"
    ]
  }
}
